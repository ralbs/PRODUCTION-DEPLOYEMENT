# Server
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/aqms

# Device auth — comma-separated list of "device_id:api_key" pairs.
# The ESP32 sends X-Device-Id + X-Device-Key; the key here must match the
# firmware's DEVICE_API_KEY (config.h).
# In production, move this into the Device collection instead (see models/Device.js).
DEVICE_KEYS=ESP32-001:change-this-to-a-long-random-string

# MQTT (optional — leave broker unset to disable live republishing)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# CORS — comma-separated list of allowed dashboard origins
ALLOWED_ORIGINS=http://localhost:3000
