#pragma once
/*
 * Copy this file to secrets.h (same directory) and fill in real values.
 * secrets.h is gitignored -- never commit it -- same discipline as
 * backend/.env.example / backend/.env.
 *
 * Security note (2026-09-17): the previous config.h hardcoded a real WiFi
 * password and device key directly in source, committed to a now-public
 * repo. Both were rotated after discovery -- the values that were in git
 * history are permanently retired, never re-used here. Anything you put in
 * THIS file is real and must never be committed.
 */

#define WIFI_SSID         "your-wifi-ssid"
#define WIFI_PASSWORD     "your-wifi-password"

// Must exactly match this device's entry in the backend's DEVICE_KEYS env
// var (Render dashboard), e.g. "ESP32-001:<this-value>" -- see
// backend/.env.example. Generate a long random string, never a
// human-readable placeholder like the retired "AQMI-DEVICE-01".
#define DEVICE_API_KEY    "change-this-to-a-long-random-string"
